{
  "schemaVersion": 1,
  "id": "th-msm",
  "name": "TH-MSM",
  "version": "1.2.0",
  "description": "Thermodynamic and Kinetic Markov State Model Intelligence Agent �� DSH Plugin",
  "host": {
    "kind": "deepseek-harness",
    "apiTrain": "0.2.x"
  },
  "entry": "./src/index.js",
  "capabilities": {
    "tools": [
      "th_msm",
      "th_msm_knowledge",
      "th_msm_teach",
      "th_msm_plan",
      "th_msm_build",
      "th_msm_validate",
      "th_msm_report"
    ],
    "agentHooks": true,
    "agentLoop": true,
    "shellExecution": true,
    "workspaceRegistry": true,
    "knowledgeBase": true,
    "requiresSandboxByDefault": true
  },
  "msm": {
    "registryFile": ".th-msm/registry.json",
    "requestProtocol": "json-stdin-v1",
    "resultProtocol": "stdout-v1",
    "primaryLibrary": "deeptime",
    "fallbackLibrary": "pyemma",
    "deeptimeUrl": "https://deeptime-ml.github.io"
  },
  "knowledge": {
    "basePath": "knowledge",
    "catalogs": ["reviews/CATALOG.md", "papers/CATALOG.md", "benchmarks/CATALOG.md"],
    "learningRoadmap": "knowledge/LEARNING_ROADMAP.md",
    "vectorStore": ".th-msm/vector"
  },
  "agent": {
    "modes": [
      { "name": "teaching", "trigger": ["解释", "什么是", "概念", "学习", "入门"], "tools": ["th_msm_knowledge", "th_msm_teach"] },
      { "name": "planning", "trigger": ["设计", "方案", "protocol", "轨迹"], "tools": ["th_msm_plan", "th_msm_knowledge"] },
      { "name": "modeling", "trigger": ["构建", "运行", "执行", "build"], "tools": ["th_msm_build", "th_msm"] },
      { "name": "validation", "trigger": ["验证", "检�?, "ITS", "CK"], "tools": ["th_msm_validate"] },
      { "name": "reporting", "trigger": ["报告", "总结", "生成"], "tools": ["th_msm_report"] }
    ],
    "principles": [
      "不盲目生成模�?�?每一步都需要理�?,
      "目标不适合 MSM 时明确告�?,
      "不隐藏模型不确定�?,
      "一切分析可复现"
    ]
  }
}