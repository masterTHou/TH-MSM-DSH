{
  "schemaVersion": 1,
  "id": "th-msm",
  "name": "Trajectory Hub for Markov State Modeling (TH-MSM)",
  "version": "1.8.0",
  "description": "MSM 脚本生成、环境自检、经典建模分析验证报告全流程与分层教学；实验性非绝热 C1/WE",
  "host": {
    "kind": "deepseek-harness",
    "apiTrain": "0.2.x"
  },
  "entry": "./lib/index.js",
  "capabilities": {
    "tools": [
      "th_msm",
      "th_msm_knowledge",
      "th_msm_teach",
      "th_msm_plan",
      "th_msm_build",
      "th_msm_validate",
      "th_msm_report",
      "th_msm_env",
      "th_msm_sample",
      "th_msm_guide",
      "th_msm_example",
      "th_msm_analyze",
      "th_msm_script",
      "th_msm_run",
      "th_msm_view"
    ],
    "agentHooks": true,
    "agentLoop": true,
    "shellExecution": true,
    "workspaceRegistry": true,
    "knowledgeBase": true,
    "requiresSandboxByDefault": true
  },
  "msm": {
    "registryFile": ".th-msm/registry.json",
    "requestProtocol": "json-stdin-v1",
    "resultProtocol": "stdout-v1",
    "primaryLibrary": "builtin-node-fssh-edc-c1",
    "fallbackLibrary": "none",
    "deeptimeUrl": "https://deeptime-ml.github.io"
  },
  "knowledge": {
    "basePath": "knowledge",
    "catalogs": [
      "reviews/CATALOG.md",
      "papers/CATALOG.md",
      "benchmarks/CATALOG.md"
    ],
    "learningRoadmap": "knowledge/LEARNING_ROADMAP.md",
    "vectorStore": ".th-msm/vector"
  },
  "agent": {
    "modes": [
      {
        "name": "teaching",
        "trigger": [
          "explain",
          "what is",
          "concept",
          "learn"
        ],
        "tools": [
          "th_msm_knowledge",
          "th_msm_teach"
        ]
      },
      {
        "name": "planning",
        "trigger": [
          "plan",
          "design",
          "protocol",
          "trajectory"
        ],
        "tools": [
          "th_msm_plan",
          "th_msm_knowledge"
        ]
      },
      {
        "name": "modeling",
        "trigger": [
          "build",
          "construct",
          "run",
          "execute"
        ],
        "tools": [
          "th_msm_guide",
          "th_msm_example",
          "th_msm_sample",
          "th_msm_build",
          "th_msm_analyze",
          "th_msm"
        ]
      },
      {
        "name": "validation",
        "trigger": [
          "validate",
          "check",
          "verify",
          "its",
          "ck-test"
        ],
        "tools": [
          "th_msm_validate"
        ]
      },
      {
        "name": "reporting",
        "trigger": [
          "report",
          "summary",
          "document"
        ],
        "tools": [
          "th_msm_report"
        ]
      }
    ],
    "principles": [
      "Never blindly generate MSM models — every step requires rationale",
      "Warn when MSM is unsuitable for the user's goal",
      "Never hide model uncertainty — distinguish numerical correctness from scientific credibility",
      "All analyses must be reproducible"
    ]
  }
}
