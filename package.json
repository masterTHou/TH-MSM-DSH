{
  "name": "@th-msm/dsh-plugin",
  "version": "1.3.0",
  "description": "FC nonadiabatic FSSH+EDC sampling and non-equilibrium C1 first-hit/flux analysis for DeepSeek Harness",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./tools/*": "./src/tools/*.js",
    "./knowledge/*": "./src/knowledge/*.js",
    "./engine": "./src/engine.js"
  },
  "files": [
    "src",
    "plugin.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "scripts",
    "docs/SCIENCE.md",
    "CHANGELOG.md",
    "benchmarks"
  ],
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4 <5",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.3",
    "@deepseek-ai/schemastery": ">=3.18 <4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "demo": "node scripts/demo.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "benchmark:full": "node scripts/benchmark.mjs --full",
    "lint": "node --check src/index.js",
    "prepack": "npm run check",
    "prepublishOnly": "npm run check && npm test"
  }
}
