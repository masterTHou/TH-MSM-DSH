{
  "name": "@th-msm/dsh-plugin",
  "version": "1.5.2",
  "description": "Trajectory Hub for Markov State Modeling (TH-MSM) — conversational modeling, kinetic analysis, learning and experimental C1/WE",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./tools/*": "./lib/tools/*.js",
    "./knowledge/*": "./lib/knowledge/*.js",
    "./engine": {
      "types": "./lib/engine.d.ts",
      "import": "./lib/engine.js",
      "default": "./lib/engine.js"
    },
    "./msm": {
      "types": "./lib/msm/index.d.ts",
      "import": "./lib/msm/index.js",
      "default": "./lib/msm/index.js"
    },
    "./education": {
      "types": "./lib/education/lessons.d.ts",
      "import": "./lib/education/lessons.js",
      "default": "./lib/education/lessons.js"
    },
    "./decision": {
      "types": "./lib/decision/router.d.ts",
      "import": "./lib/decision/router.js",
      "default": "./lib/decision/router.js"
    }
  },
  "files": [
    "lib",
    "plugin.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "scripts",
    "docs",
    "examples/msm",
    "CHANGELOG.md",
    "benchmarks"
  ],
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4 <5",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.3",
    "@deepseek-ai/schemastery": ">=3.18 <4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.type-tests.json",
    "pretest": "npm run build:codex",
    "test": "node --test test/*.test.mjs",
    "check": "npm run typecheck && node scripts/check.mjs",
    "predemo": "node scripts/ensure-build.mjs",
    "predemo:msm": "node scripts/ensure-build.mjs",
    "demo:msm": "node scripts/demo-msm.mjs",
    "demo": "node scripts/demo.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "benchmark:full": "node scripts/benchmark.mjs --full",
    "prebenchmark": "node scripts/ensure-build.mjs",
    "prebenchmark:full": "node scripts/ensure-build.mjs",
    "lint": "npm run typecheck",
    "prepack": "npm run build && npm run check",
    "prepublishOnly": "npm run check && npm test",
    "build:codex": "npm run build && node scripts/build-codex.mjs",
    "pack:codex": "npm run build:codex && node scripts/pack-codex.mjs"
  },
  "dependencies": {
    "ml-matrix": "^6.15.0"
  },
  "bundledDependencies": [
    "ml-matrix"
  ],
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/node": "^26.6.5",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
